{
  "name": "novapull",
  "version": "1.2.0",
  "description": "A clean Windows video downloader powered by yt-dlp",
  "main": "src/main.js",
  "author": "NovaPull contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/naming.js && node --check src/quality.js && node --check src/account.js && node --check src/usage.js && node --check src/sniffer.js && node --check src/media-probe.js && node --check src/preload.js && node --check src/renderer.js && node --check src/share-url.js && node --check src/theme-boot.js && node --check src/i18n.js && node --check src/update.js",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win nsis portable && node scripts/collect-artifacts.js",
    "icon": "node scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.novapull.desktop",
    "productName": "NovaPull",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "protocols": {
      "name": "NovaPull deep link",
      "schemes": [
        "novapull"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "NovaPull-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "NovaPull-${version}-setup.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "publish": null
  }
}
